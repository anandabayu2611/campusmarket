rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Seluruh akses data dilakukan server (Laravel) lewat Firebase Admin SDK,
    // yang mem-bypass rules ini. Tolak semua akses langsung dari klien/browser.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
