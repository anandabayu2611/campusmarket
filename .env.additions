# ====== Tambahkan/ubah di file .env proyek Laravel ======

# Firebase (service account JSON dari Firebase Console > Project settings > Service accounts)
FIREBASE_CREDENTIALS=storage/app/firebase/firebase-credentials.json
FIREBASE_PROJECT=app
FIRESTORE_DATABASE=(default)
FIREBASE_STORAGE_DEFAULT_BUCKET=nama-project-anda.firebasestorage.app

# Tanpa database SQL, jadi session/cache/queue tidak boleh memakai driver "database"
SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync

# Email: "log" -> kode verifikasi tampil di storage/logs/laravel.log (untuk development)
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@campusmarket.test"
MAIL_FROM_NAME="CampusMarket"
# Produksi: pakai SMTP (Mailtrap/Gmail/SES/dll)
